# Ключ доступа сообщества VK (Управление → Работа с API → Ключи доступа)
# Права: «Сообщения сообщества» и «Управление сообществом»
VK_TOKEN=

# ID сообщества — только цифры, без минуса (например, из адреса club123456789)
VK_GROUP_ID=

# Адрес локального сайта с виджетом (serve_site.py)
SITE_HOST=127.0.0.1
SITE_PORT=8080
